    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DUNE uses your location to record outdoor workout routes and to ask if you have finished after you walk away from a stair machine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屋外ワークアウトのルートを記録し、階段マシンから離れて移動した際に運動を終了したか確認するため、位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "야외 운동 경로를 기록하고, 계단 기구에서 내려와 이동하면 운동을 마쳤는지 묻기 위해 위치를 사용해요."
          }
        }
      }
    },
