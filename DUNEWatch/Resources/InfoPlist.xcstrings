    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DUNE uses your location to record outdoor routes, mark indoor workout places, and detect when you leave a stair machine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屋外の運動ルートと屋内の運動場所を記録し、階段マシンから離れたことを検出するために位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "야외 운동 경로와 실내 운동 장소를 기록하고, 계단 기구에서 내려와 이동했는지 확인하기 위해 위치를 사용해요."
          }
        }
      }
