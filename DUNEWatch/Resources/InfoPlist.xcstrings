{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DUNE uses your location during stair workouts to ask if you have finished after you walk away from the machine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "階段マシンから離れて移動した際に、ワークアウトを終了したか確認するため、運動中の位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계단 기구에서 내려와 이동하면 운동을 마쳤는지 묻기 위해 운동 중 위치를 사용해요."
          }
        }
      }
    }
  },
  "version" : "1.0"
}